# ==============================================================================
# QueueCut Environment Variables (Copy to .env for local/staging deployments)
# ==============================================================================

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL Connection
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/queuecut
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# Security & JWT
JWT_SECRET=super-secret-jwt-key-minimum-32-characters-change-in-production
JWT_EXPIRATION_MS=86400000

# Barber Initial Seed Credentials
BARBER_INITIAL_PASSWORD=arslan123

# Allowed CORS Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
